{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "web-bluetooth"
    ],
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "react-native-svg": [
        "./node_modules/react-native-svg"
      ],
      "react-native": [
        "./node_modules/react-native/types_generated/index.d.ts"
      ]
    }
  },
  "include": [
    "./*.tsx",
    "../core/*.ts",
    "../core/transports/*.ts",
    "../app/**/*.ts",
    "../app/**/*.tsx"
  ],
  "exclude": [
    "**/*.test.ts",
    "../core/**/*.test.ts",
    "../app/**/*.test.ts"
  ]
}
